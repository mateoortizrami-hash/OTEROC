# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# SOLO servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
# Se usa únicamente para registrar/eliminar clientes desde el panel admin.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# URL pública del sitio (para SEO: sitemap, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
